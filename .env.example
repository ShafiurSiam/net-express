# Copy this file to .env and fill in real values. Never commit .env.

# External payment gateway link used by every "বিল পরিশোধ" button (src/config/payment.js)
VITE_PAYMENT_URL=https://example.com/payment

# Canonical site URL, used for SEO/Open Graph tags (src/config/site.js)
VITE_SITE_URL=https://netexpress.example.com

# Only needed if/when the coverage map is upgraded to a real Google Map
VITE_GOOGLE_MAPS_KEY=

# Google Apps Script web app URL that receives connection request submissions
# and appends them as rows to a Google Sheet (src/components/ui/ConnectionRequestForm.jsx)
VITE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbzun9PrCXzZrCpS5TFTT3F40pNAyUCltWJr-Cm_P9ZPNKGn4G-JsAVC1nOmOvdve2lp/exec
